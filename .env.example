# ============ 后端切换开关 ============
# 现在没有API Key/Milvus时,保持mock,整个项目依然能开发和测试
VECTOR_BACKEND=mock
LLM_BACKEND=mock

# ============ Postgres(现在就可以配一个本地/Docker实例) ============
PG_HOST=localhost
PG_PORT=5432
PG_DB=kb_structured
PG_USER=postgres
PG_PASSWORD=

# ============ Milvus(资源到位后再填,并把VECTOR_BACKEND改成real) ============
MILVUS_HOST=
MILVUS_PORT=19530

# ============ ClickHouse(资源到位后再填) ============
CK_HOST=
CK_INTROSPECT_USER=
CK_INTROSPECT_PASSWORD=
CK_QUERY_USER=
CK_QUERY_PASSWORD=

# ============ LLM(拿到Key后再填,并把LLM_BACKEND改成real) ============
ANTHROPIC_API_KEY=
